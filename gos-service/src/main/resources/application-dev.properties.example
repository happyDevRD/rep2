# Perfil desarrollo local
# 1. Copiar este archivo como application-dev.properties
# 2. Ajustar URL, usuario y contraseña de tu entorno
# 3. Activar con: spring.profiles.active=dev

spring.datasource.url=jdbc:mysql://HOST:3306/DATABASE
spring.datasource.username=USER
spring.datasource.password=CHANGE_ME

spring.jpa.show-sql=true

notifica.modo=mock
notifica.cod-dir3=
notifica.procedimiento-sia=

jwt.secret=${JWT_SECRET:dev-secret-change-in-production}
jwt.enabled=false
